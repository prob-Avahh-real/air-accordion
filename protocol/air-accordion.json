{
  "name": "air-accordion",
  "version": "1.1.0",
  "description": "空气手风琴 — 风箱推拉门控 + 低音/旋律键",
  "instrument": "accordion",
  "model": {
    "bellows": "signed push/pull −1..1; deadzone silences reeds (AND-gate with keys)",
    "bellows_deadzone": 0.12,
    "idle_auto_sway": false,
    "melody": "C major diatonic + accidentals",
    "bass": "root + triad buttons"
  },
  "gestures": {
    "phone": {
      "tilt_gamma": { "action": "bellows", "note": "portrait left-right push/pull" }
    },
    "ring": {
      "tilt": { "action": "select_melody", "threshold_deg": 5, "throttle_frames": 8 },
      "shake": { "action": "toggle_sustain", "threshold_deg": 20, "throttle_frames": 8 }
    },
    "cane": {
      "swing": { "action": "bellows_nudge", "threshold": 3, "throttle_frames": 6 },
      "tap": { "action": "attack_selected", "accel_spike": 8, "throttle_frames": 6 }
    }
  },
  "bass_ids": ["C", "F", "G", "Am", "Dm", "Em", "Bb", "G7"],
  "melody_labels": ["C", "D", "E", "F", "G", "A", "B", "C5", "C#", "D#", "F#", "G#"]
}
